<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>XEMX</title>
    <welcome file="welcome.html"/>
    <conclusion file="conclusion.html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="For Ableton Live, Bitwig, Cubase, Reaper and other VST3 hosts.">
        <pkg-ref id="com.xemx.xemx.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="For Logic Pro, GarageBand and Ableton Live (AU).">
        <pkg-ref id="com.xemx.xemx.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="XEMX as its own app in /Applications.">
        <pkg-ref id="com.xemx.xemx.app"/>
    </choice>
    <pkg-ref id="com.xemx.xemx.vst3">xemx-vst3.pkg</pkg-ref>
    <pkg-ref id="com.xemx.xemx.au">xemx-au.pkg</pkg-ref>
    <pkg-ref id="com.xemx.xemx.app">xemx-app.pkg</pkg-ref>
</installer-gui-script>
